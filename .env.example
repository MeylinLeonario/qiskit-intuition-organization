# Local development: SQLite is created automatically; no secrets are committed.
AUTH_DATABASE_URL=sqlite:///data/auth.sqlite3
AUTH_FRONTEND_URL=http://localhost:3000
# Optional locally; required in production. Generate a random value of 32+ bytes.
AUTH_JWT_SECRET=

# Vercel backend: configure these as secrets in the deployment settings.
# TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=

# Resend: use a sender on your verified domain. Without a key, local development
# writes preview messages to the SQLite email_outbox instead of sending email.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
